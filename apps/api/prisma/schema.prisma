generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, citext]
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum LandingStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum VersionStatus {
  AUTOSAVE
  MANUAL
  PUBLISHED
  ROLLBACK
}

enum WidgetType {
  REACT
  VANILLA_JS
  IFRAME
  WEB_COMPONENT
}

enum WidgetStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum AssetType {
  IMAGE
  VIDEO
  FONT
  ICON
  DOCUMENT
  ARCHIVE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLISH
  UNPUBLISH
  DUPLICATE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
}

enum PublishTarget {
  CLOUDFLARE_PAGES
  S3_CDN
  VERCEL
  CUSTOM_HOST
}

enum PublishJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum PlaceholderType {
  TEXT
  TEXTAREA
  RICHTEXT
  NUMBER
  BOOLEAN
  COLOR
  IMAGE
  VIDEO
  SELECT
  MULTISELECT
  ARRAY
  URL
  DATE
  JSON
}

enum LegacySource {
  UPLOAD
  GIT_REPO
  FTP
  S3_IMPORT
  ZIP
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.Citext
  passwordHash  String?
  name          String?
  avatarUrl     String?
  role          Role      @default(EDITOR)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  emailVerified DateTime?

  ownedLandings    Landing[]    @relation("LandingOwner")
  versions         Version[]
  auditLogs        AuditLog[]
  assets           Asset[]
  sessions         Session[]
  apiKeys          ApiKey[]
  publishJobs      PublishJob[]
  templateAuthored Template[]   @relation("TemplateAuthor")
  widgetAuthored   Widget[]     @relation("WidgetAuthor")
  comments         Comment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String    @db.VarChar(12)
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([prefix])
}

model Geo {
  id        String  @id @default(cuid())
  code      String  @unique @db.VarChar(8)
  name      String
  language  String  @db.VarChar(16)
  currency  String  @db.VarChar(4)
  flagEmoji String?
  flagUrl   String?
  timezone  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  metadata  Json?

  landings  Landing[]
  templates TemplateGeo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([language])
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  landings  Landing[]
  templates Template[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Variant {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  landings Landing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Template {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  description  String?
  thumbnailUrl String?
  previewUrl   String?

  baseHtml     String  @db.Text
  baseCss      String? @db.Text
  baseJs       String? @db.Text
  grapesJson   Json?
  placeholders Json
  blocksJson   Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  authorId String?
  author   User?   @relation("TemplateAuthor", fields: [authorId], references: [id])

  allowedGeos TemplateGeo[]
  landings    Landing[]

  tags     String[] @default([])
  isPublic Boolean  @default(false)
  isActive Boolean  @default(true)
  version  String   @default("1.0.0")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive, isPublic])
  @@index([slug])
}

model TemplateGeo {
  templateId String
  geoId      String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  geo        Geo      @relation(fields: [geoId], references: [id], onDelete: Cascade)

  @@id([templateId, geoId])
  @@index([geoId])
}

model Landing {
  id       String @id @default(cuid())
  publicId String @unique
  name     String
  slug     String

  geoId String
  geo   Geo    @relation(fields: [geoId], references: [id], onDelete: Restrict)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  status LandingStatus @default(DRAFT)

  previewUrl   String?
  publishedUrl String?
  customDomain String?

  currentVersionId String?   @unique
  currentVersion   Version?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions         Version[] @relation("AllVersions")

  ownerId String
  owner   User   @relation("LandingOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  lockedById  String?
  lockedAt    DateTime?
  lockExpires DateTime?

  pixels    Json?
  postbacks Json?
  seoMeta   Json?
  settings  Json?

  tags  String[] @default([])
  notes String?  @db.Text

  publishJobs PublishJob[]
  assets      Asset[]
  comments    Comment[]
  legacyFrom  LegacyLanding? @relation("LegacyImport")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  deletedAt   DateTime?

  @@unique([geoId, slug])
  @@index([status, deletedAt])
  @@index([geoId, categoryId, variantId])
  @@index([ownerId])
  @@index([templateId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([tags])
}

model Version {
  id        String   @id @default(cuid())
  landingId String
  landing   Landing  @relation("AllVersions", fields: [landingId], references: [id], onDelete: Cascade)
  currentOf Landing? @relation("CurrentVersion")

  versionNum Int
  status     VersionStatus @default(MANUAL)

  grapesJson   Json
  placeholders Json

  html      String? @db.Text
  css       String? @db.Text
  customCss String? @db.Text
  customJs  String? @db.Text

  snapshotS3Key String?
  snapshotSize  Int?

  authorId String
  author   User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  message  String?

  parentVersionId String?
  parentVersion   Version?  @relation("VersionParent", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        Version[] @relation("VersionParent")

  createdAt DateTime @default(now())

  @@unique([landingId, versionNum])
  @@index([landingId, createdAt])
  @@index([authorId])
  @@index([status])
}

model PublishJob {
  id        String           @id @default(cuid())
  landingId String
  landing   Landing          @relation(fields: [landingId], references: [id], onDelete: Cascade)
  versionId String?
  target    PublishTarget    @default(CLOUDFLARE_PAGES)
  status    PublishJobStatus @default(QUEUED)

  triggeredById String
  triggeredBy   User   @relation(fields: [triggeredById], references: [id], onDelete: Restrict)

  logs      String? @db.Text
  error     String? @db.Text
  resultUrl String?
  duration  Int?

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([landingId, createdAt])
  @@index([status])
}

model Widget {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  description String?
  type        WidgetType   @default(VANILLA_JS)
  status      WidgetStatus @default(DRAFT)
  category    String?

  versions WidgetVersion[]

  thumbnailUrl String?
  previewUrl   String?
  tags         String[] @default([])

  authorId String?
  author   User?   @relation("WidgetAuthor", fields: [authorId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, deletedAt])
  @@index([category])
}

model WidgetVersion {
  id         String   @id @default(cuid())
  widgetId   String
  widget     Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  version    String
  bundleUrl  String
  bundleHash String
  schema     Json
  changelog  String?  @db.Text
  isLatest   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([widgetId, version])
  @@index([widgetId, isLatest])
}

model Asset {
  id        String   @id @default(cuid())
  landingId String?
  landing   Landing? @relation(fields: [landingId], references: [id], onDelete: Cascade)

  uploaderId String
  uploader   User   @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  type         AssetType
  mimeType     String
  originalName String
  s3Key        String    @unique
  s3Bucket     String
  url          String?
  size         Int
  width        Int?
  height       Int?
  duration     Int?
  hash         String?

  folder String?
  tags   String[] @default([])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([landingId])
  @@index([uploaderId])
  @@index([type])
  @@index([hash])
  @@index([folder])
}

model LegacyLanding {
  id           String       @id @default(cuid())
  name         String
  path         String       @unique
  source       LegacySource @default(UPLOAD)
  sourceUrl    String?
  branch       String?
  commitSha    String?
  lastSyncedAt DateTime?
  syncStatus   String?
  syncError    String?      @db.Text
  sizeBytes    BigInt       @default(0)
  fileCount    Int          @default(0)
  fileTree     Json
  tags         String[]     @default([])
  geoHint      String?
  categoryHint String?

  importedAsId String?   @unique
  importedAs   Landing?  @relation("LegacyImport", fields: [importedAsId], references: [id], onDelete: SetNull)
  importedAt   DateTime?

  files LegacyFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
  @@index([sourceUrl])
  @@index([syncStatus])
  @@index([geoHint])
  @@index([importedAsId])
}

model LegacyFile {
  id              String        @id @default(cuid())
  legacyLandingId String
  legacy          LegacyLanding @relation(fields: [legacyLandingId], references: [id], onDelete: Cascade)
  path            String
  s3Key           String
  size            Int
  mimeType        String?
  extension       String?
  textContent     String?       @db.Text
  hash            String?
  isBinary        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  updatedById     String?

  @@unique([legacyLandingId, path])
  @@index([legacyLandingId])
  @@index([hash])
  @@index([extension])
}

model Comment {
  id         String    @id @default(cuid())
  landingId  String
  landing    Landing   @relation(fields: [landingId], references: [id], onDelete: Cascade)
  authorId   String
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")
  body       String    @db.Text
  anchor     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([landingId])
  @@index([authorId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
