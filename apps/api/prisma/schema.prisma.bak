generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, pgcrypto]
}

model User {
  id                String               @id @default(cuid())
  email             String               @unique @db.Citext
  passwordHash      String?
  name              String?
  avatarUrl         String?
  role              Role                 @default(EDITOR)
  isActive          Boolean              @default(true)
  lastLoginAt       DateTime?
  emailVerified     DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?
  apiKeys           ApiKey[]
  assets            Asset[]
  auditLogs         AuditLog[]
  comments          Comment[]
  componentAuthored Component[]          @relation("ComponentAuthor")
  oauthAccounts     OAuthAccount[]
  ownedLandings     Landing[]            @relation("LandingOwner")
  builderPages      BuilderPage[]        @relation("BuilderPageOwner")
  publishJobs       PublishJob[]
  sessions          Session[]
  templateAuthored  Template[]           @relation("TemplateAuthor")
  versions          Version[]
  builderVersions   BuilderPageVersion[] @relation("BuilderPageAuthor")
  widgetAuthored    Widget[]             @relation("WidgetAuthor")
  mediaFolders      MediaFolder[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String    @db.VarChar(12)
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
}

model Geo {
  id        String        @id @default(cuid())
  code      String        @unique @db.VarChar(8)
  name      String
  language  String        @db.VarChar(16)
  currency  String        @db.VarChar(4)
  flagEmoji String?
  flagUrl   String?
  timezone  String?
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  landings  Landing[]
  templates TemplateGeo[]
  prices    Price[]

  @@index([isActive, sortOrder])
  @@index([language])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  color       String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  landings    Landing[]
  products  Product[]
  templates Template[]

  @@index([isActive, sortOrder])
}

model Variant {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  landings    Landing[]

  @@index([isActive, sortOrder])
}

model Template {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  description  String?
  thumbnailUrl String?
  previewUrl   String?
  baseHtml     String
  baseCss      String?
  baseJs       String?
  grapesJson   Json?
  placeholders Json
  blocksJson   Json?
  categoryId   String?
  authorId     String?
  tags         String[]      @default([])
  isPublic     Boolean       @default(false)
  isActive     Boolean       @default(true)
  version      String        @default("1.0.0")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  landings     Landing[]
  author       User?         @relation("TemplateAuthor", fields: [authorId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  allowedGeos  TemplateGeo[]

  @@index([categoryId])
  @@index([isActive, isPublic])
  @@index([slug])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Template_name_trgm_idx", type: Gin)
}

model TemplateGeo {
  templateId String
  geoId      String
  geo        Geo      @relation(fields: [geoId], references: [id], onDelete: Cascade)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, geoId])
  @@index([geoId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Landing {
  id               String         @id @default(cuid())
  publicId         String         @unique
  name             String
  slug             String
  geoId            String
  categoryId       String
  variantId        String
  templateId       String?
  status           LandingStatus  @default(DRAFT)
  previewUrl       String?
  publishedUrl     String?
  customDomain     String?
  currentVersionId String?        @unique
  ownerId          String
  lockedById       String?
  lockedAt         DateTime?
  lockExpires      DateTime?
  pixels           Json?
  postbacks        Json?
  seoMeta          Json?
  settings         Json?
  tags             String[]       @default([])
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  publishedAt      DateTime?
  deletedAt        DateTime?
  assets           Asset[]
  comments         Comment[]
  category         Category       @relation(fields: [categoryId], references: [id])
  currentVersion   Version?       @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  geo              Geo            @relation(fields: [geoId], references: [id])
  owner            User           @relation("LandingOwner", fields: [ownerId], references: [id])
  template         Template?      @relation(fields: [templateId], references: [id])
  variant          Variant        @relation(fields: [variantId], references: [id])
  legacyFrom       LegacyLanding? @relation("LegacyImport")
  publishJobs      PublishJob[]
  versions         Version[]      @relation("AllVersions")
  product          Product?       @relation(fields: [productId], references: [id])
  productId        String?

  @@unique([geoId, slug])
  @@index([status, deletedAt])
  @@index([geoId, categoryId, variantId])
  @@index([ownerId])
  @@index([templateId])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([tags])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Landing_name_trgm_idx", type: Gin)
}

model Version {
  id              String        @id @default(cuid())
  landingId       String
  versionNum      Int
  status          VersionStatus @default(MANUAL)
  grapesJson      Json
  placeholders    Json
  html            String?
  css             String?
  customCss       String?
  customJs        String?
  snapshotS3Key   String?
  snapshotSize    Int?
  authorId        String
  message         String?
  parentVersionId String?
  createdAt       DateTime      @default(now())
  currentOf       Landing?      @relation("CurrentVersion")
  author          User          @relation(fields: [authorId], references: [id])
  landing         Landing       @relation("AllVersions", fields: [landingId], references: [id], onDelete: Cascade)
  parentVersion   Version?      @relation("VersionParent", fields: [parentVersionId], references: [id])
  children        Version[]     @relation("VersionParent")

  @@unique([landingId, versionNum])
  @@index([landingId, createdAt])
  @@index([authorId])
  @@index([status])
}

model PublishJob {
  id            String           @id @default(cuid())
  landingId     String
  versionId     String?
  target        PublishTarget    @default(CLOUDFLARE_PAGES)
  status        PublishJobStatus @default(QUEUED)
  triggeredById String
  logs          String?
  error         String?
  resultUrl     String?
  duration      Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime         @default(now())
  landing       Landing          @relation(fields: [landingId], references: [id], onDelete: Cascade)
  triggeredBy   User             @relation(fields: [triggeredById], references: [id])

  @@index([landingId, createdAt])
  @@index([status])
}

model BuilderPage {
  id               String               @id @default(cuid())
  name             String
  status           BuilderPageStatus    @default(DRAFT)
  ownerId          String
  currentVersionId String?              @unique
  html             String?
  css              String?
  components       Json?
  styles           Json?
  assets           Json?
  design           Json?
  device           String?              @db.VarChar(16)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?
  owner            User                 @relation("BuilderPageOwner", fields: [ownerId], references: [id])
  currentVersion   BuilderPageVersion?  @relation("CurrentBuilderPageVersion", fields: [currentVersionId], references: [id])
  versions         BuilderPageVersion[] @relation("AllBuilderPageVersions")

  @@index([ownerId, updatedAt])
  @@index([status, deletedAt])
}

model BuilderPageVersion {
  id            String               @id @default(cuid())
  builderPageId String
  versionNum    Int
  status        BuilderVersionStatus @default(AUTOSAVE)
  html          String?
  css           String?
  components    Json?
  styles        Json?
  assets        Json?
  design        Json?
  device        String?              @db.VarChar(16)
  message       String?
  authorId      String
  createdAt     DateTime             @default(now())
  currentOf     BuilderPage?         @relation("CurrentBuilderPageVersion")
  page          BuilderPage          @relation("AllBuilderPageVersions", fields: [builderPageId], references: [id], onDelete: Cascade)
  author        User                 @relation("BuilderPageAuthor", fields: [authorId], references: [id])

  @@unique([builderPageId, versionNum])
  @@index([builderPageId, createdAt])
  @@index([authorId])
}

model Widget {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  description  String?
  type         WidgetType      @default(VANILLA_JS)
  status       WidgetStatus    @default(DRAFT)
  category     String?
  thumbnailUrl String?
  previewUrl   String?
  tags         String[]        @default([])
  authorId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  author       User?           @relation("WidgetAuthor", fields: [authorId], references: [id])
  versions     WidgetVersion[]

  @@index([status, deletedAt])
  @@index([category])
}

model WidgetVersion {
  id         String   @id @default(cuid())
  widgetId   String
  version    String
  bundleUrl  String
  bundleHash String
  schema     Json
  changelog  String?
  isLatest   Boolean  @default(false)
  createdAt  DateTime @default(now())
  widget     Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([widgetId, version])
  @@index([widgetId, isLatest])
}

model Asset {
  id           String       @id @default(cuid())
  landingId    String?
  uploaderId   String
  type         AssetType
  mimeType     String
  originalName String
  s3Key        String       @unique
  s3Bucket     String
  url          String?
  size         Int
  width        Int?
  height       Int?
  duration     Int?
  hash         String?
  folder       String?
  folderId     String?
  tags         String[]     @default([])
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?
  landing      Landing?     @relation(fields: [landingId], references: [id], onDelete: Cascade)
  uploader     User         @relation(fields: [uploaderId], references: [id])
  mediaFolder  MediaFolder? @relation(fields: [folderId], references: [id])

  @@index([landingId])
  @@index([uploaderId])
  @@index([type])
  @@index([hash])
  @@index([folder])
  @@index([folderId])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  slug      String
  parentId  String?
  ownerId   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")
  owner     User          @relation(fields: [ownerId], references: [id])
  assets    Asset[]

  @@unique([parentId, slug])
  @@index([parentId])
  @@index([ownerId])
  @@index([deletedAt])
}

model LegacyLanding {
  id           String       @id @default(cuid())
  name         String
  path         String       @unique
  source       LegacySource @default(UPLOAD)
  sizeBytes    BigInt       @default(0)
  fileCount    Int          @default(0)
  fileTree     Json
  tags         String[]     @default([])
  geoHint      String?
  categoryHint String?
  importedAsId String?      @unique
  importedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  sourceUrl    String?
  branch       String?
  commitSha    String?
  lastSyncedAt DateTime?
  syncStatus   String?
  syncError    String?
  files        LegacyFile[]
  importedAs   Landing?     @relation("LegacyImport", fields: [importedAsId], references: [id])

  @@index([source])
  @@index([sourceUrl])
  @@index([syncStatus])
  @@index([geoHint])
  @@index([importedAsId])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model LegacyFile {
  id              String        @id @default(cuid())
  legacyLandingId String
  path            String
  s3Key           String
  size            Int
  mimeType        String?
  hash            String?
  isBinary        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  extension       String?
  textContent     String?
  updatedAt       DateTime      @default(now()) @updatedAt
  updatedById     String?
  legacy          LegacyLanding @relation(fields: [legacyLandingId], references: [id], onDelete: Cascade)

  @@unique([legacyLandingId, path])
  @@index([legacyLandingId])
  @@index([hash])
  @@index([extension])
  @@index([path(ops: raw("gin_trgm_ops"))], map: "LegacyFile_path_trgm_idx", type: Gin)
}

model Comment {
  id         String    @id @default(cuid())
  landingId  String
  authorId   String
  parentId   String?
  body       String
  anchor     Json?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  landing    Landing   @relation(fields: [landingId], references: [id], onDelete: Cascade)
  parent     Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentThread")

  @@index([landingId])
  @@index([authorId])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())
  user      User?       @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ComponentCategory {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  icon        String?
  description String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  components  Component[]

  @@index([isActive, sortOrder])
}

model Component {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  description   String?
  html          String
  css           String?
  previewBg     String?
  previewDark   Boolean            @default(false)
  previewHeight Int                @default(400)
  categoryId    String
  tags          String[]           @default([])
  isPinned      Boolean            @default(false)
  isPublic      Boolean            @default(true)
  usageCount    Int                @default(0)
  authorId      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  author        User?              @relation("ComponentAuthor", fields: [authorId], references: [id])
  category      ComponentCategory  @relation(fields: [categoryId], references: [id])
  variants      ComponentVariant[]

  @@index([categoryId])
  @@index([isPinned])
  @@index([usageCount])
  @@index([deletedAt])
}

model ComponentVariant {
  id          String    @id @default(cuid())
  componentId String
  name        String
  html        String
  css         String?
  sortOrder   Int       @default(0)
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([componentId, name])
  @@index([componentId, sortOrder])
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum LandingStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum VersionStatus {
  AUTOSAVE
  MANUAL
  PUBLISHED
  ROLLBACK
}

enum WidgetType {
  REACT
  VANILLA_JS
  IFRAME
  WEB_COMPONENT
}

enum WidgetStatus {
  DRAFT
  PUBLISHED
  DEPRECATED
}

enum AssetType {
  IMAGE
  VIDEO
  FONT
  ICON
  DOCUMENT
  ARCHIVE
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLISH
  UNPUBLISH
  DUPLICATE
  LOGIN
  LOGOUT
  IMPORT
  EXPORT
}

enum PublishTarget {
  CLOUDFLARE_PAGES
  S3_CDN
  VERCEL
  CUSTOM_HOST
}

enum PublishJobStatus {
  QUEUED
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum BuilderPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BuilderVersionStatus {
  AUTOSAVE
  MANUAL
  PUBLISHED
}

enum PlaceholderType {
  TEXT
  TEXTAREA
  RICHTEXT
  NUMBER
  BOOLEAN
  COLOR
  IMAGE
  VIDEO
  SELECT
  MULTISELECT
  ARRAY
  URL
  DATE
  JSON
}

enum OAuthProvider {
  GOOGLE
}

model OAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  email             String?
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

enum LegacySource {
  UPLOAD
  GIT_REPO
  FTP
  S3_IMPORT
  ZIP
}

// ─── Catalog: Product (offer) and Price (history) ──────────────────────────
// Why separate from Category:
//   Category = vertical/niche (e.g. "urology")
//   Product  = concrete sellable SKU (e.g. "Xenoprost Active")
//   One Category has many Products. One Product can be sold in many Geos
//   at different prices over time.

model Product {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String?
  categoryId   String? // optional: legacy products may be uncategorized
  defaultImage String? // Asset.id (loose FK)
  claimsKey    String? // i18n key root for legal claims, e.g. "claims.prostate"
  meta         Json      @default("{}") // free-form: vendor SKU, packaging, etc.
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])
  prices   Price[]
  landings Landing[]

  @@index([categoryId])
  @@index([archivedAt])
  @@index([slug])
}

// Append-only price history.
// Active price for (product, geo, at) = row with MAX(validFrom) where
// validFrom <= at AND (validTo IS NULL OR validTo > at).
// New row is inserted in the same transaction that closes the previous open
// period (sets its validTo = new.validFrom). See PricingService (Phase 1.2).

model Price {
  id        String    @id @default(cuid())
  productId String
  geoId     String? // null = global default
  price     Decimal   @db.Decimal(12, 4)
  oldPrice  Decimal?  @db.Decimal(12, 4)
  currency  String // ISO 4217, e.g. "EUR"
  validFrom DateTime
  validTo   DateTime? // null = currently open
  createdBy String // userId (denormalized for fast audit)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  geo     Geo?    @relation(fields: [geoId], references: [id], onDelete: SetNull)

  @@unique([productId, geoId, validFrom])
  @@index([productId, geoId, validFrom])
  @@index([validFrom])
}

// ─── i18n strings ───────────────────────────────────────────────────────────
// Used by widgets / templates / runtime to fetch translations by (key, lang).
// Distinct from Template.placeholders which defines schema; this stores values.

model I18nString {
  id         String   @id @default(cuid())
  key        String // e.g. "cta.buy_now"
  lang       String // BCP-47 base, e.g. "de"
  value      String
  context    String? // hint for translators
  isApproved Boolean  @default(false)
  source     String? // "manual" | "llm" | "import"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([key, lang])
  @@index([lang])
  @@index([key])
  @@index([isApproved])
}
