{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@workspace/types": ["packages/types/dist/index.d.ts"],
      "@workspace/types/*": ["packages/types/dist/*"]
    },
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "test/**/*.ts", "vitest.config.ts"]
}
