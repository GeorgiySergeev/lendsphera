NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landing_builder?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=landing-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# JWT Secrets
# SECURITY: These MUST be changed from defaults in production!
# Generate new secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 32 random characters, ACCESS and REFRESH must be different from each other
JWT_ACCESS_SECRET=dev-access-secret-change-me-use-32-random-chars-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-use-32-random-chars-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:4000/api
GITHUB_ACCESS_TOKEN= your-github-access-token

# CORS Configuration
# Only these origins can make cross-origin requests to the API
# Must be HTTPS in production (e.g., https://editor.yourdomain.com)
WEB_ORIGIN=http://localhost:3002
RUNTIME_ORIGIN=http://localhost:3001

# Cookie security (used by cookie-parser to sign refresh token cookies)
# In production: generate with `openssl rand -base64 32`
COOKIE_SECRET=dev-cookie-secret-change-me-in-prod

CLOUDFLARE_API_TOKEN= your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID= your-cloudflare-account-id
CLOUDFLARE_ZONE_ID= your-cloudflare-zone-id
CLOUDFLARE_ZONE_NAME= your-cloudflare-zone-name

# Google OAuth (optional — all four must be set together or all left empty)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
# Authorized JS origins: http://localhost:3002, http://localhost:4000
GOOGLE_CLIENT_ID= your-google-client-id
GOOGLE_CLIENT_SECRET= your-google-client-secret
GOOGLE_CALLBACK_URL= your-google-callback-url
GOOGLE_OAUTH_SUCCESS_REDIRECT= your-google-oauth-success-redirect   

# Set to "true" to show the "Continue with Google" button in the UI
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false

GRAPES_PLATFORM_API_KEY=your-grapes-platform-api-key