{
  "name": "@workspace/widgets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "default": "./dist/widgets/manifest.json"
    }
  },
  "scripts": {
    "build": "vite build && tsx scripts/generate-manifest.ts && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "publish:bundles": "tsx scripts/publish-widgets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@workspace/types": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.956.0",
    "tsx": "^4.21.0",
    "vite": "^7.3.1"
  }
}
