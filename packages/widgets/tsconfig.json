{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": "../..",
    "paths": {
      "@workspace/types": ["packages/types/dist/index.d.ts"],
      "@workspace/types/*": ["packages/types/dist/*"]
    },
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.test.ts",
    ".storybook/**/*.ts",
    "scripts/**/*.ts",
    "tests/visual/**/*.ts",
    "playwright.visual.config.ts",
    "vite.config.ts"
  ]
}
